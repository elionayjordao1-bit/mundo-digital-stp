rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // AUTENTICAÇÃO / RBAC — FASE 6.7.1 — BLINDAGEM DE PERFIS
    // ================================================================

    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function isAtivo() {
      // Compatível com utilizadores antigos que ainda não tenham o campo status.
      // Evita "Missing or insufficient permissions" por acesso a campo inexistente.
      return isAuth() &&
        (
          !getUserData().keys().hasAny(["status"]) ||
          getUserData().status == "ativo"
        );
    }

    function hasRole(role) {
      return isAtivo() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isGerente() {
      return hasRole("gerente");
    }

    function isEstoque() {
      return hasRole("estoque");
    }

    function isGestor() {
      return isAdmin() || isGerente();
    }

    function isVendedorPuro() {
      return isAtivo() &&
        (
          getUserData().role == "venda1" ||
          getUserData().role == "venda2"
        );
    }

    function isVendedor() {
      return isAdmin() || isVendedorPuro();
    }

    function isGerenteEmSubstituicao() {
      return isGerente() &&
        exists(/databases/$(database)/documents/substituicoes_operacionais/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/substituicoes_operacionais/$(request.auth.uid)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/substituicoes_operacionais/$(request.auth.uid)).data.estado == "ativa" &&
        get(/databases/$(database)/documents/substituicoes_operacionais/$(request.auth.uid)).data.contexto == "substituicao_operacional";
    }

    function isOperadorCaixa() {
      return isAdmin() || isVendedorPuro() || isGerenteEmSubstituicao();
    }

    function isAdminOuEstoque() {
      return isGestor() || isEstoque();
    }

    // FASE 6.8 — abertura de Caixa financiada pela Reserva.
    // O vendedor nunca lê o razão da Tesouraria; trabalha apenas com um saldo-resumo
    // e a operação precisa ser atómica: saldo-resumo + movimento + novo Caixa.
    function aberturaCaixaFinanciadaValida(caixaId) {
      return
        request.resource.data.valorInicial > 0 &&
        request.resource.data.origemValorInicial == "responsavel_stp" &&
        getAfter(
          /databases/$(database)/documents/tesouraria_saldos/responsavel_stp
        ).data.ultimoCaixaId == caixaId &&
        getAfter(
          /databases/$(database)/documents/tesouraria_saldos/responsavel_stp
        ).data.ultimoUid == request.auth.uid &&
        getAfter(
          /databases/$(database)/documents/tesouraria_movimentos/$(caixaId)
        ).data.tipo == "abertura_caixa" &&
        getAfter(
          /databases/$(database)/documents/tesouraria_movimentos/$(caixaId)
        ).data.caixaId == caixaId &&
        getAfter(
          /databases/$(database)/documents/tesouraria_movimentos/$(caixaId)
        ).data.uid == request.auth.uid &&
        getAfter(
          /databases/$(database)/documents/tesouraria_movimentos/$(caixaId)
        ).data.origem == "responsavel_stp" &&
        getAfter(
          /databases/$(database)/documents/tesouraria_movimentos/$(caixaId)
        ).data.destino == "caixa_stp" &&
        getAfter(
          /databases/$(database)/documents/tesouraria_movimentos/$(caixaId)
        ).data.valorOrigem == request.resource.data.valorInicial &&
        getAfter(
          /databases/$(database)/documents/tesouraria_movimentos/$(caixaId)
        ).data.valorDestino == request.resource.data.valorInicial;
    }

    function roleValida(data) {
      return data.role == "admin" ||
             data.role == "gerente" ||
             data.role == "venda1" ||
             data.role == "venda2" ||
             data.role == "estoque";
    }

    function statusValido(data) {
      return !data.keys().hasAny(["status"]) ||
             data.status == "ativo" ||
             data.status == "desativado";
    }

    function produtoCamposValidos(data) {
      return data.keys().hasOnly([
        "nome", "barcode", "categoria", "estoque", "minimo",
        "compra", "venda", "foto"
      ]);
    }

    function caixaEhProprioEAberto(caixaId) {
      return caixaId != null &&
        get(
          /databases/$(database)/documents/caixas/$(caixaId)
        ).data.uid == request.auth.uid &&
        get(
          /databases/$(database)/documents/caixas/$(caixaId)
        ).data.estado == "aberto";
    }

    function encomendaEhPropria(encId) {
      return encId != null &&
        get(
          /databases/$(database)/documents/encomendas/$(encId)
        ).data.uid == request.auth.uid;
    }


    // FASE 6.12.1 — movimento físico determinístico, ligado 1:1 ao pedido aprovado.
    // O ID do documento em movimentacoes é o próprio pedidoId, impedindo duplicação.
    function movimentoCaixaAprovadoValido(movId) {
      return request.resource.data.solicitacaoCaixaId != null &&
        request.resource.data.solicitacaoCaixaId == movId &&
        existsAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
        ) &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
        ).data.estado == "APROVADA_EXECUTADA" &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
        ).data.caixaId == request.resource.data.caixaId &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
        ).data.valor == request.resource.data.valor &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
        ).data.solicitanteUid == request.resource.data.uid &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
        ).data.origemConta == request.resource.data.origemTesouraria &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
        ).data.destinoConta == request.resource.data.destinoTesouraria &&
        (
          (
            request.resource.data.tipo == "suprimento_caixa" &&
            getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
            ).data.tipo == "SUPRIMENTO" &&
            request.resource.data.destinoTesouraria == "caixa_stp"
          ) ||
          (
            request.resource.data.tipo == "sangria_caixa" &&
            getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.solicitacaoCaixaId)
            ).data.tipo == "SANGRIA" &&
            request.resource.data.origemTesouraria == "caixa_stp"
          )
        );
    }

    // FASE 6.12.1 — saldo-resumo da conta STN tocada pela aprovação.
    // SUPRIMENTO reduz a origem; SANGRIA aumenta o destino.
    function saldoCaixaAprovadoValido(saldoId) {
      return request.resource.data.ultimoPedidoCaixaId != null &&
        existsAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
        ) &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
        ).data.estado == "APROVADA_EXECUTADA" &&
        getAfter(
          /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
        ).data.decididoPorUid == request.auth.uid &&
        request.resource.data.moeda == "STN" &&
        request.resource.data.saldo >= 0 &&
        (
          (
            getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
            ).data.tipo == "SUPRIMENTO" &&
            getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
            ).data.origemConta == saldoId &&
            request.resource.data.ultimaOperacao == "suprimento_caixa_aprovado" &&
            request.resource.data.saldo == resource.data.saldo - getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
            ).data.valor
          ) ||
          (
            getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
            ).data.tipo == "SANGRIA" &&
            getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
            ).data.destinoConta == saldoId &&
            request.resource.data.ultimaOperacao == "sangria_caixa_aprovada" &&
            request.resource.data.saldo == resource.data.saldo + getAfter(
              /databases/$(database)/documents/caixa_movimento_solicitacoes/$(request.resource.data.ultimoPedidoCaixaId)
            ).data.valor
          )
        );
    }

    // ================================================================
    // USUÁRIOS
    // ================================================================

    match /usuarios/{userId} {

      allow get: if isAuth() &&
        (
          isAdmin() ||
          userId == request.auth.uid
        );

      allow list: if isAdmin();

      // Só ADMIN cria perfis e a estrutura mínima precisa ser válida.
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(["nome", "email", "role", "status"]) &&
        request.resource.data.nome is string &&
        request.resource.data.email is string &&
        roleValida(request.resource.data) &&
        statusValido(request.resource.data);

      // Própria conta ADMIN: somente o nome.
      // Outros utilizadores: ADMIN só altera nome, role e status,
      // e os valores de role/status continuam limitados à matriz oficial.
      allow update: if isAdmin() &&
        (
          (
            userId == request.auth.uid &&
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(["nome"])
          )
          ||
          (
            userId != request.auth.uid &&
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(["nome", "role", "status"]) &&
            roleValida(request.resource.data) &&
            statusValido(request.resource.data)
          )
        );

      allow delete: if isAdmin() &&
        userId != request.auth.uid;
    }

    // ================================================================
    // PRODUTOS
    // ================================================================

    match /produtos/{produtoId} {

      // Nota: Firestore não faz segurança por campo em reads. O custo "compra"
      // continua no mesmo documento por compatibilidade e será migrado depois.
      allow read: if isAtivo();

      // ADMIN cria o produto oficial completo.
      // ESTOQUE pode criar cadastro operacional, mas sem definir custo de compra.
      allow create: if produtoCamposValidos(request.resource.data) &&
        request.resource.data.estoque >= 0 &&
        request.resource.data.minimo >= 0 &&
        request.resource.data.venda >= 0 &&
        (
          isGestor()
          ||
          (
            isEstoque() &&
            request.resource.data.compra == 0
          )
        );

      allow update: if
        (
          isGestor() &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["nome", "barcode", "categoria", "estoque", "minimo", "compra", "venda", "foto"]) &&
          request.resource.data.estoque >= 0 &&
          request.resource.data.minimo >= 0 &&
          request.resource.data.compra >= 0 &&
          request.resource.data.venda >= 0
        )
        ||
        (
          // ESTOQUE gere dados operacionais, mas não toca no custo de compra.
          isEstoque() &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["nome", "barcode", "categoria", "estoque", "minimo", "venda", "foto"]) &&
          request.resource.data.estoque >= 0 &&
          request.resource.data.minimo >= 0 &&
          request.resource.data.venda >= 0
        )
        ||
        (
          // VENDA1/VENDA2 só podem baixar estoque em uma venda autorizada.
          isVendedorPuro() &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["estoque"]) &&
          request.resource.data.estoque >= 0 &&
          request.resource.data.estoque <= resource.data.estoque
        );

      allow delete: if isAdmin();
    }

    // ================================================================
    // FASE 6.10 — RASTREABILIDADE IMUTÁVEL DE PRODUTOS
    // ================================================================
    match /produto_rastreabilidade/{rastroId} {
      allow read: if isGestor() ||
        (isEstoque() && resource.data.uid == request.auth.uid);

      allow create: if (isGestor() || isEstoque()) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == getUserData().role &&
        request.resource.data.produtoId is string &&
        request.resource.data.produtoNome is string &&
        request.resource.data.acao is string;

      allow update, delete: if false;
    }

    // Marco único do inventário inicial. Só ADMIN cria; ninguém altera/apaga.
    match /sistema_marcos/{marcoId} {
      allow read: if isGestor() || isEstoque();
      allow create: if isAdmin() &&
        marcoId == "inventario_inicial" &&
        request.resource.data.tipo == "INVENTARIO_INICIAL" &&
        request.resource.data.estado == "CONFIRMADO" &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ================================================================
    // MOVIMENTAÇÕES / HISTÓRICO
    // Imutável. Vendedor lê apenas os próprios movimentos.
    // ================================================================

    match /movimentacoes/{movId} {

      allow read: if isGestor() ||
        (
          isVendedorPuro() &&
          resource.data.uid == request.auth.uid
        );

      allow create: if isAtivo() &&
        (
          // ADMIN/GERENTE: operações administrativas operacionais, estornos e integrações.
          // Suprimento/Sangria são exceção: só nascem de uma solicitação aprovada/executada.
          (
            isGestor() &&
            (
              (
                request.resource.data.tipo != "suprimento_caixa" &&
                request.resource.data.tipo != "sangria_caixa"
              )
              ||
              movimentoCaixaAprovadoValido(movId)
            )
          )

          ||

          // ESTOQUE: somente entrada/reabastecimento com rastro próprio.
          (
            isEstoque() &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.tipo == "entrada"
          )

          ||

          // VENDEDORES: somente operações operacionais permitidas.
          (
            isVendedorPuro() &&
            request.resource.data.uid == request.auth.uid &&
            (
              // Venda normal: sempre vinculada ao próprio caixa aberto.
              (
                request.resource.data.tipo == "saida" &&
                (
                  !request.resource.data.keys().hasAny(["origem"]) ||
                  request.resource.data.origem != "encomenda"
                ) &&
                request.resource.data.caixaId != null &&
                caixaEhProprioEAberto(request.resource.data.caixaId)
              )

              ||

              // Entrada/saída física de transferência.
              (
                (
                  request.resource.data.tipo == "transferencia_entrada" ||
                  request.resource.data.tipo == "transferencia_saida"
                ) &&
                request.resource.data.caixaId != null &&
                caixaEhProprioEAberto(request.resource.data.caixaId) &&
                request.resource.data.transferenciaId != null &&
                getAfter(
                  /databases/$(database)/documents/transferencias/$(request.resource.data.transferenciaId)
                ).data.uid == request.auth.uid
              )

              ||

              // FASE 6.5.1 — sinal físico provisório de encomenda pendente.
              (
                request.resource.data.tipo == "reserva_sinal_encomenda" &&
                request.resource.data.caixaId != null &&
                caixaEhProprioEAberto(request.resource.data.caixaId) &&
                request.resource.data.solicitacaoEncomendaId != null &&
                getAfter(
                  /databases/$(database)/documents/encomenda_solicitacoes/$(request.resource.data.solicitacaoEncomendaId)
                ).data.uid == request.auth.uid &&
                getAfter(
                  /databases/$(database)/documents/encomenda_solicitacoes/$(request.resource.data.solicitacaoEncomendaId)
                ).data.estado == "PENDENTE_APROVACAO"
              )

              ||

              // FASE 6.5.1 — movimento físico provisório de transferência pendente.
              (
                (
                  request.resource.data.tipo == "reserva_transferencia_saida" ||
                  request.resource.data.tipo == "reserva_transferencia_entrada"
                ) &&
                request.resource.data.caixaId != null &&
                caixaEhProprioEAberto(request.resource.data.caixaId) &&
                request.resource.data.solicitacaoTransferenciaId != null &&
                getAfter(
                  /databases/$(database)/documents/transferencia_solicitacoes/$(request.resource.data.solicitacaoTransferenciaId)
                ).data.uid == request.auth.uid &&
                getAfter(
                  /databases/$(database)/documents/transferencia_solicitacoes/$(request.resource.data.solicitacaoTransferenciaId)
                ).data.estado == "PENDENTE_APROVACAO"
              )

              ||

              // FASE 6.12 — suprimento direto pelo vendedor foi desativado.
              // O movimento só é criado por ADMIN/GERENTE após aprovação formal.

              // Recebimentos de encomenda própria.
              (
                request.resource.data.tipo == "saida" &&
                request.resource.data.origem == "encomenda" &&
                request.resource.data.encomendaId != null &&
                encomendaEhPropria(request.resource.data.encomendaId) &&
                (
                  (
                    request.resource.data.formaPagamento.matches('^Dinheiro.*') &&
                    request.resource.data.caixaId != null &&
                    caixaEhProprioEAberto(request.resource.data.caixaId)
                  )
                  ||
                  (
                    !request.resource.data.formaPagamento.matches('^Dinheiro.*') &&
                    (
                      !request.resource.data.keys().hasAny(["caixaId"]) ||
                      request.resource.data.caixaId == null
                    )
                  )
                )
              )

              ||

              // Custo de chegada de encomenda própria.
              (
                request.resource.data.tipo == "despesa_caixa" &&
                request.resource.data.origem == "encomenda" &&
                request.resource.data.encomendaId != null &&
                encomendaEhPropria(request.resource.data.encomendaId) &&
                (
                  (
                    request.resource.data.formaPagamento == "Dinheiro - Custo Encomenda" &&
                    request.resource.data.caixaId != null &&
                    caixaEhProprioEAberto(request.resource.data.caixaId)
                  )
                  ||
                  (
                    request.resource.data.formaPagamento == "Transferencia - Custo Encomenda" &&
                    (
                      !request.resource.data.keys().hasAny(["caixaId"]) ||
                      request.resource.data.caixaId == null
                    )
                  )
                )
              )
            )
          )
        );

      // Histórico financeiro nunca é editado/apagado pelo sistema.
      allow update, delete: if false;
    }

    // ================================================================
    // DESPESAS OPERACIONAIS
    // ================================================================

    match /despesas/{despId} {
      allow read, create: if isGestor();
      allow update, delete: if false;
    }

    // ================================================================
    // FASE 6.5.1 — PEDIDOS DE ENCOMENDAS PARA APROVAÇÃO
    // ================================================================

    match /encomenda_solicitacoes/{pedidoId} {

      allow read: if isGestor() ||
        (
          isVendedorPuro() &&
          resource.data.uid == request.auth.uid
        );

      allow create: if isVendedorPuro() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == "PENDENTE_APROVACAO" &&
        request.resource.data.valorTotal > 0 &&
        request.resource.data.sinalInformado > 0 &&
        request.resource.data.sinalInformado <= request.resource.data.valorTotal &&
        (
          (
            request.resource.data.formaSinal == "Dinheiro" &&
            request.resource.data.caixaId != null &&
            caixaEhProprioEAberto(request.resource.data.caixaId)
          )
          ||
          (
            request.resource.data.formaSinal != "Dinheiro" &&
            request.resource.data.caixaId == null
          )
        );

      // FASE 6.22.8 — aprovação comercial separada da compra ao fornecedor.
      // ADMIN aprova o pedido e cria a encomenda oficial em AGUARDANDO_COMPRA,
      // sem custo de compra e sem débito na Tesouraria. A compra é registada depois
      // no documento oficial da encomenda, continuando exclusiva do ADMIN.
      allow update: if isAdmin() &&
        resource.data.estado == "PENDENTE_APROVACAO" &&
        (
          (
            request.resource.data.estado == "APROVADA" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado","encomendaId","aprovadoPorUid","aprovadoPorUsuario","dataAprovacao",
              "efeitoFinanceiroDefinitivo"
            ]) &&
            request.resource.data.aprovadoPorUid == request.auth.uid &&
            request.resource.data.efeitoFinanceiroDefinitivo == false &&
            existsAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)) &&
            getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)).data.solicitacaoId == pedidoId &&
            getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)).data.estado == "AGUARDANDO_COMPRA" &&
            getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)).data.custoCompra == 0 &&
            getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)).data.aprovadoPorUid == request.auth.uid
          )
          ||
          (
            request.resource.data.estado == "REJEITADA" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado","motivoRejeicao","rejeitadoPorUid","rejeitadoPorUsuario",
              "dataRejeicao","efeitoFinanceiroDefinitivo"
            ]) &&
            request.resource.data.rejeitadoPorUid == request.auth.uid &&
            request.resource.data.efeitoFinanceiroDefinitivo == false &&
            request.resource.data.motivoRejeicao is string &&
            request.resource.data.motivoRejeicao.size() > 0
          )
        );
      allow delete: if false;
    }

    // ================================================================
    // FASE 6.5.1 — PEDIDOS DE TRANSFERÊNCIAS PARA APROVAÇÃO
    // ================================================================

    match /transferencia_solicitacoes/{pedidoId} {

      allow read: if isGestor() ||
        (
          isVendedorPuro() &&
          resource.data.uid == request.auth.uid
        );

      allow create: if isVendedorPuro() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == "PENDENTE_APROVACAO" &&
        request.resource.data.qtdEur > 0 &&
        request.resource.data.totalDb > 0 &&
        (
          request.resource.data.direcao == "PT_STP" ||
          request.resource.data.direcao == "STP_PT"
        ) &&
        (
          (
            request.resource.data.formaSTP == "Dinheiro" &&
            request.resource.data.caixaId != null &&
            caixaEhProprioEAberto(request.resource.data.caixaId)
          )
          ||
          (
            request.resource.data.formaSTP != "Dinheiro" &&
            request.resource.data.caixaId == null
          )
        );

      allow update: if isGestor() &&
        resource.data.estado == "PENDENTE_APROVACAO" &&
        (
          request.resource.data.estado == "APROVADA" ||
          request.resource.data.estado == "REJEITADA"
        );

      allow delete: if false;
    }

    // ================================================================
    // ENCOMENDAS OFICIAIS
    // ADMIN/GERENTE gerem. Vendedor apenas consulta as próprias.
    // ================================================================

    match /encomendas/{encId} {

      // Firestore Rules não são filtros: a condição por UID também se aplica
      // às consultas. Por isso o HTML 6.4 consulta com where("uid","==",uid).
      allow read: if isGestor() ||
        (
          isVendedorPuro() &&
          resource.data.uid == request.auth.uid
        );

      // FASE 6.22.2 — encomenda oficial nasce somente por ação do ADMIN.
      // GERENTE pode continuar a gerir o acompanhamento operacional, mas não
      // pode criar/alterar os campos que determinam o pagamento da compra.
      allow create: if isAdmin();

      allow update: if
        isAdmin()
        ||
        (
          isGerente() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estado","custosChegada","custoTotalReal","lucroReal",
            "dataConclusao","formaPagamentoFinal","valorPagamentoFinal",
            "observacaoFinal","telefone","observacao"
          ])
        );

      allow delete: if isAdmin();
    }

    // ================================================================
    // TRANSFERÊNCIAS PORTUGAL ⇄ SÃO TOMÉ
    // ================================================================

    match /transferencias/{transferenciaId} {

      allow read: if isGestor() ||
        (
          isVendedorPuro() &&
          resource.data.uid == request.auth.uid
        );

      // FASE 6.5.1: transferência oficial nasce somente por aprovação ADMIN.
      allow create: if isGestor() &&
        request.resource.data.estado == "CONCLUIDA" &&
        request.resource.data.qtdEur > 0 &&
        request.resource.data.totalDb > 0;

      allow update, delete: if false;
    }

    // ================================================================
    // TESOURARIA & POSIÇÃO FINANCEIRA
    // Inclui prestação de contas, capital e financiamento.
    // ================================================================

    match /tesouraria_movimentos/{movTesId} {
      // O histórico financeiro completo continua exclusivo do ADMIN.
      allow read: if isGestor();

      // ADMIN/GERENTE mantêm acesso operacional integral.
      // VENDA1/VENDA2 só podem criar UM movimento muito específico:
      // financiamento do próprio Caixa na abertura, vindo da Reserva,
      // com o mesmo ID do Caixa para impedir duplicação.
      allow create: if
        (
          (isAdmin() &&
            request.resource.data.tipo != "suprimento_caixa_aprovado" &&
            request.resource.data.tipo != "sangria_caixa_aprovada" &&
            request.resource.data.origem != "caixa_stp" &&
            request.resource.data.destino != "caixa_stp")
          ||
          (isGerente() &&
            request.resource.data.tipo != "saldo_inicial" &&
            request.resource.data.tipo != "aporte_socio" &&
            request.resource.data.tipo != "emprestimo_socio" &&
            request.resource.data.tipo != "emprestimo_banco" &&
            request.resource.data.tipo != "retirada_socio" &&
            request.resource.data.tipo != "amortizacao_socio" &&
            request.resource.data.tipo != "amortizacao_banco" &&
            request.resource.data.tipo != "compra_encomenda" &&
            request.resource.data.origem != "caixa_stp" &&
            request.resource.data.destino != "caixa_stp")
        ) ||
        (
          // FASE 6.12 — contrapartida financeira de Suprimento/Sangria aprovada.
          isGestor() &&
          request.resource.data.solicitacaoCaixaId == movTesId &&
          (
            request.resource.data.tipo == "suprimento_caixa_aprovado" ||
            request.resource.data.tipo == "sangria_caixa_aprovada"
          ) &&
          existsAfter(
            /databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)
          ) &&
          getAfter(
            /databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)
          ).data.estado == "APROVADA_EXECUTADA" &&
          getAfter(
            /databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)
          ).data.caixaId == request.resource.data.caixaId &&
          getAfter(
            /databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)
          ).data.valor == request.resource.data.valorOrigem &&
          request.resource.data.valorDestino == request.resource.data.valorOrigem &&
          request.resource.data.moedaOrigem == "STN" &&
          request.resource.data.moedaDestino == "STN" &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.solicitanteUid == getAfter(
            /databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)
          ).data.solicitanteUid &&
          request.resource.data.origem == getAfter(
            /databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)
          ).data.origemConta &&
          request.resource.data.destino == getAfter(
            /databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)
          ).data.destinoConta &&
          (
            (
              getAfter(/databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)).data.tipo == "SUPRIMENTO" &&
              getAfter(/databases/$(database)/documents/tesouraria_saldos/$(request.resource.data.origem)).data.ultimoPedidoCaixaId == movTesId
            ) ||
            (
              getAfter(/databases/$(database)/documents/caixa_movimento_solicitacoes/$(movTesId)).data.tipo == "SANGRIA" &&
              getAfter(/databases/$(database)/documents/tesouraria_saldos/$(request.resource.data.destino)).data.ultimoPedidoCaixaId == movTesId
            )
          )
        ) ||
        (
          (isAdmin() || isVendedorPuro() || isGerenteEmSubstituicao()) &&
          movTesId == request.resource.data.caixaId &&
          request.resource.data.tipo == "abertura_caixa" &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.origem == "responsavel_stp" &&
          request.resource.data.destino == "caixa_stp" &&
          request.resource.data.moedaOrigem == "STN" &&
          request.resource.data.moedaDestino == "STN" &&
          request.resource.data.valorOrigem > 0 &&
          request.resource.data.valorDestino == request.resource.data.valorOrigem &&
          getAfter(
            /databases/$(database)/documents/caixas/$(request.resource.data.caixaId)
          ).data.uid == request.auth.uid &&
          getAfter(
            /databases/$(database)/documents/caixas/$(request.resource.data.caixaId)
          ).data.estado == "aberto" &&
          getAfter(
            /databases/$(database)/documents/caixas/$(request.resource.data.caixaId)
          ).data.valorInicial == request.resource.data.valorOrigem
        );

      allow update, delete: if false;
    }

    // Saldo-resumo mínimo da Reserva.
    // Não contém histórico, observações, contrapartes ou outros dados financeiros.
    match /tesouraria_saldos/{saldoId} {
      allow read: if isGestor() ||
        ((isVendedorPuro() || isGerenteEmSubstituicao()) && saldoId == "responsavel_stp");

      // ADMIN inicializa/sincroniza os saldos-resumo do razão completo.
      // GERENTE não pode inventar um saldo novo.
      allow create: if isAdmin();

      // ADMIN pode sincronizar o resumo a partir do razão. GERENTE só o altera
      // quando a própria alteração fizer parte de uma aprovação formal 6.12.1.
      // Vendedor/substituição apenas reduzem a Reserva na abertura do próprio Caixa.
      allow update: if isAdmin() ||
        (isGerente() && saldoCaixaAprovadoValido(saldoId)) ||
        (
          (isVendedorPuro() || isGerenteEmSubstituicao()) &&
          saldoId == "responsavel_stp" &&
          resource.data.saldo >= 0 &&
          request.resource.data.saldo >= 0 &&
          request.resource.data.saldo < resource.data.saldo &&
          request.resource.data.moeda == "STN" &&
          request.resource.data.ultimoUid == request.auth.uid &&
          request.resource.data.ultimoCaixaId != null &&
          request.resource.data.ultimaOperacao == "abertura_caixa" &&
          request.resource.data.saldo ==
            resource.data.saldo -
            getAfter(
              /databases/$(database)/documents/caixas/$(request.resource.data.ultimoCaixaId)
            ).data.valorInicial &&
          getAfter(
            /databases/$(database)/documents/caixas/$(request.resource.data.ultimoCaixaId)
          ).data.uid == request.auth.uid &&
          getAfter(
            /databases/$(database)/documents/caixas/$(request.resource.data.ultimoCaixaId)
          ).data.estado == "aberto" &&
          getAfter(
            /databases/$(database)/documents/tesouraria_movimentos/$(request.resource.data.ultimoCaixaId)
          ).data.tipo == "abertura_caixa" &&
          getAfter(
            /databases/$(database)/documents/tesouraria_movimentos/$(request.resource.data.ultimoCaixaId)
          ).data.uid == request.auth.uid
        );

      allow delete: if false;
    }

    // ================================================================
    // ARMAZÉM PORTUGAL — FASE 6.4.7 — ADMIN CONSOLIDA RECEBIMENTO FINAL
    // ESTOQUE prepara compra/despacho. ADMIN recebe em STP, consolida custo e movimenta dinheiro.
    // ================================================================

    // Itens oficiais: só nascem após aprovação/admin. Nunca são apagados.
    match /armazem_pt/{itemId} {
      allow read: if isAdminOuEstoque();
      allow create: if isGestor();
      allow update: if isGestor();
      allow delete: if false;
    }

    // Lotes oficiais: ADMIN/GERENTE criam, despacham, recebem e consolidam custos.
    // ESTOQUE mantém leitura operacional, sem permissão de alterar o lote oficial.
    match /lotes_pt/{loteId} {
      allow read: if isAdminOuEstoque();
      // Lote oficial nasce após aprovação GERENTE/ADMIN.
      allow create: if isGestor();
      // GERENTE/ADMIN gerem aprovação/despacho. ESTOQUE só pode concluir o recebimento físico.
      allow update: if isGestor() || (
        isEstoque() &&
        resource.data.estado == "EM_TRANSITO" &&
        request.resource.data.estado == "RECEBIDO" &&
        request.resource.data.recebidoPorUid == request.auth.uid &&
        request.resource.data.acertoValor == 0
      );
      allow delete: if false;
    }

    // Compra preparada pelo ESTOQUE. Não cria stock nem mexe na Tesouraria.
    match /armazem_compra_solicitacoes/{pedidoId} {
      allow read: if isGestor() ||
        (isEstoque() && resource.data.uid == request.auth.uid);

      allow create: if isEstoque() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == "PENDENTE_APROVACAO" &&
        request.resource.data.quantidade > 0 &&
        request.resource.data.custoUnitario > 0 &&
        request.resource.data.total > 0 &&
        (request.resource.data.moeda == "EUR" || request.resource.data.moeda == "STN") &&
        (
          (request.resource.data.moeda == "EUR" && request.resource.data.contaPagamento == "portugal_eur") ||
          (request.resource.data.moeda == "STN" &&
            (request.resource.data.contaPagamento == "responsavel_stp" || request.resource.data.contaPagamento == "banco_stp"))
        );

      allow update: if isGestor() &&
        resource.data.estado == "PENDENTE_APROVACAO" &&
        (request.resource.data.estado == "APROVADA" || request.resource.data.estado == "REJEITADA");

      allow delete: if false;
    }

    // Despacho preparado pelo ESTOQUE. Artigos continuam em Lisboa até aprovação.
    match /armazem_despacho_solicitacoes/{pedidoId} {
      allow read: if isGestor() ||
        (isEstoque() && resource.data.uid == request.auth.uid);

      allow create: if isEstoque() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == "PENDENTE_APROVACAO" &&
        request.resource.data.identificador != "" &&
        request.resource.data.idsItens.size() > 0 &&
        request.resource.data.freteValor >= 0 &&
        (request.resource.data.freteMoeda == "EUR" || request.resource.data.freteMoeda == "STN") &&
        (
          request.resource.data.freteValor == 0 ||
          (request.resource.data.freteMoeda == "EUR" && request.resource.data.contaPagamento == "portugal_eur") ||
          (request.resource.data.freteMoeda == "STN" &&
            (request.resource.data.contaPagamento == "responsavel_stp" || request.resource.data.contaPagamento == "banco_stp"))
        );

      allow update: if isGestor() &&
        resource.data.estado == "PENDENTE_APROVACAO" &&
        (request.resource.data.estado == "APROVADA" || request.resource.data.estado == "REJEITADA");

      allow delete: if false;
    }

    // Solicitações de acerto mantidas apenas para compatibilidade com registos antigos.
    // Na Fase 6.4.7 novos recebimentos/acertos são executados diretamente pelo ADMIN.
    match /armazem_acerto_solicitacoes/{pedidoId} {
      allow read: if isGestor() ||
        (isEstoque() && resource.data.uid == request.auth.uid);

      allow create: if false;

      // ADMIN ainda pode decidir solicitações pendentes criadas por versões anteriores.
      allow update: if isGestor() &&
        resource.data.estado == "PENDENTE_APROVACAO" &&
        (request.resource.data.estado == "APROVADA" || request.resource.data.estado == "REJEITADA");

      allow delete: if false;
    }

    // Histórico próprio do Armazém: ADMIN/ESTOQUE leem; eventos são imutáveis.
    match /armazem_movimentos/{movArmId} {
      allow read: if isAdminOuEstoque();

      allow create: if isGestor() ||
        (
          isEstoque() &&
          request.resource.data.uid == request.auth.uid &&
          (
            request.resource.data.tipo == "COMPRA_SOLICITADA" ||
            request.resource.data.tipo == "DESPACHO_SOLICITADO" ||
            request.resource.data.tipo == "RECEBIMENTO_LOTE"
          )
        );

      allow update, delete: if false;
    }

    // Pagamentos/acertos financeiros do Armazém são ação financeira crítica do ADMIN.
    match /pagamentos_despacho/{pagamentoId} {
      allow read: if isAdminOuEstoque();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ================================================================
    // CAIXAS / TURNOS
    // Vendedor só lê/fecha o próprio caixa.
    // Prestação posterior é exclusiva do ADMIN.
    // ================================================================

    match /caixas/{caixaId} {

      allow read: if isGestor() ||
        (
          isVendedorPuro() &&
          resource.data.uid == request.auth.uid
        );

      allow create: if isOperadorCaixa() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == "aberto" &&
        request.resource.data.valorInicial >= 0 &&
        (
          // Caixa sem fundo inicial: permitido normalmente.
          request.resource.data.valorInicial == 0
          ||
          // Caixa com dinheiro inicial: precisa da operação atómica
          // Responsável/Reserva -> Caixa e do débito do saldo-resumo.
          aberturaCaixaFinanciadaValida(caixaId)
        );

      allow update: if
        isAdmin()
        ||
        (
          (isVendedorPuro() || isGerenteEmSubstituicao()) &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          resource.data.estado == "aberto" &&
          request.resource.data.estado == "fechado" &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "estado",
              "dinheiroEsperado",
              "dinheiroContado",
              "diferenca",
              "totalEntradasDinheiro",
              "totalSaidasDinheiro",
              "observacaoFechamento",
              "fechadoPorUid",
              "fechadoPorUsuario",
              "dataFechamento",
              "prestacaoObrigatoria",
              "valorPrestado",
              "valorPrestacaoPendente",
              "estadoPrestacao"
            ]) &&
          request.resource.data.fechadoPorUid == request.auth.uid &&
          request.resource.data.prestacaoObrigatoria == true &&
          request.resource.data.valorPrestado == 0 &&
          request.resource.data.valorPrestacaoPendente == request.resource.data.dinheiroContado &&
          (
            (
              request.resource.data.dinheiroContado > 0 &&
              request.resource.data.estadoPrestacao == "PENDENTE"
            )
            ||
            (
              request.resource.data.dinheiroContado == 0 &&
              request.resource.data.estadoPrestacao == "PRESTADA"
            )
          )
        );

      // Turnos/caixas fazem parte da trilha de auditoria: nunca são apagados.
      allow delete: if false;
    }

    // ================================================================
    // FASE 6.12.1 — SOLICITAÇÕES DE SUPRIMENTO / SANGRIA DE CAIXA
    // Pedido não movimenta dinheiro. A decisão APROVADA_EXECUTADA deve ocorrer
    // atomicamente com movimento físico + Tesouraria + saldo-resumo da conta STN.
    // ================================================================
    match /caixa_movimento_solicitacoes/{pedidoId} {
      allow read: if isGestor() ||
        (isAtivo() && resource.data.solicitanteUid == request.auth.uid);

      allow create: if isOperadorCaixa() &&
        request.resource.data.keys().hasAll([
          "tipo","estado","valor","moeda","caixaId","origemConta","destinoConta",
          "motivo","observacao","solicitanteUid","solicitanteUsuario","solicitanteNome",
          "solicitanteRole","contexto","dataSolicitacao"
        ]) &&
        request.resource.data.keys().hasOnly([
          "tipo","estado","valor","moeda","caixaId","origemConta","destinoConta",
          "motivo","observacao","solicitanteUid","solicitanteUsuario","solicitanteNome",
          "solicitanteRole","contexto","dataSolicitacao"
        ]) &&
        request.resource.data.solicitanteUid == request.auth.uid &&
        request.resource.data.solicitanteRole == getUserData().role &&
        request.resource.data.estado == "PENDENTE_APROVACAO" &&
        request.resource.data.valor > 0 &&
        request.resource.data.moeda == "STN" &&
        request.resource.data.caixaId != null &&
        caixaEhProprioEAberto(request.resource.data.caixaId) &&
        (
          (
            request.resource.data.tipo == "SUPRIMENTO" &&
            request.resource.data.destinoConta == "caixa_stp" &&
            (
              request.resource.data.origemConta == "responsavel_stp" ||
              request.resource.data.origemConta == "banco_stp"
            )
          ) ||
          (
            request.resource.data.tipo == "SANGRIA" &&
            request.resource.data.origemConta == "caixa_stp" &&
            (
              request.resource.data.destinoConta == "responsavel_stp" ||
              request.resource.data.destinoConta == "banco_stp"
            )
          )
        );

      allow update: if resource.data.estado == "PENDENTE_APROVACAO" &&
        request.resource.data.solicitanteUid == resource.data.solicitanteUid &&
        request.resource.data.solicitanteUsuario == resource.data.solicitanteUsuario &&
        request.resource.data.solicitanteNome == resource.data.solicitanteNome &&
        request.resource.data.solicitanteRole == resource.data.solicitanteRole &&
        request.resource.data.contexto == resource.data.contexto &&
        request.resource.data.dataSolicitacao == resource.data.dataSolicitacao &&
        request.resource.data.caixaId == resource.data.caixaId &&
        request.resource.data.tipo == resource.data.tipo &&
        request.resource.data.valor == resource.data.valor &&
        request.resource.data.moeda == resource.data.moeda &&
        request.resource.data.origemConta == resource.data.origemConta &&
        request.resource.data.destinoConta == resource.data.destinoConta &&
        request.resource.data.motivo == resource.data.motivo &&
        request.resource.data.observacao == resource.data.observacao &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado","decididoPorUid","decididoPorUsuario","decididoPorNome","decididoPorRole",
          "dataDecisao","motivoRejeicao","executadoEm","movimentoCaixaId",
          "movimentoTesourariaId","saldoContaAntes","saldoContaDepois","saldoFisicoAntes"
        ]) &&
        request.resource.data.decididoPorUid == request.auth.uid &&
        request.resource.data.decididoPorRole == getUserData().role &&
        (
          // ADMIN decide qualquer pedido. Pedidos com Banco são exclusivos do ADMIN.
          (
            isAdmin() &&
            (
              request.resource.data.estado == "APROVADA_EXECUTADA" ||
              request.resource.data.estado == "REJEITADA"
            )
          )
          ||
          // GERENTE nunca decide o próprio pedido e só decide Reserva <-> Caixa.
          (
            isGerente() &&
            resource.data.solicitanteUid != request.auth.uid &&
            (
              request.resource.data.estado == "APROVADA_EXECUTADA" ||
              request.resource.data.estado == "REJEITADA"
            ) &&
            (
              (resource.data.tipo == "SUPRIMENTO" && resource.data.origemConta == "responsavel_stp") ||
              (resource.data.tipo == "SANGRIA" && resource.data.destinoConta == "responsavel_stp")
            )
          )
        ) &&
        (
          // Aprovação: exige IDs determinísticos e data de execução.
          (
            request.resource.data.estado == "APROVADA_EXECUTADA" &&
            request.resource.data.movimentoCaixaId == pedidoId &&
            request.resource.data.movimentoTesourariaId == pedidoId &&
            request.resource.data.executadoEm == request.resource.data.dataDecisao
          )
          ||
          // Rejeição: motivo obrigatório e nenhum rastro financeiro criado pelo update.
          (
            request.resource.data.estado == "REJEITADA" &&
            request.resource.data.motivoRejeicao is string &&
            request.resource.data.motivoRejeicao.size() > 0 &&
            !request.resource.data.keys().hasAny(["movimentoCaixaId","movimentoTesourariaId","executadoEm"])
          )
        );

      allow delete: if false;
    }

    // ================================================================
    // FASE 6.11 — SUBSTITUIÇÃO OPERACIONAL DA GERENTE
    // Estado atual por UID + histórico imutável.
    // ================================================================
    match /substituicoes_operacionais/{uid} {
      allow read: if isAdmin() || (isGerente() && request.auth.uid == uid);
      allow create: if isGerente() && request.auth.uid == uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.roleOriginal == "gerente" &&
        request.resource.data.contexto == "substituicao_operacional" &&
        request.resource.data.estado == "ativa";
      allow update: if isGerente() && request.auth.uid == uid &&
        resource.data.uid == request.auth.uid &&
        resource.data.estado == "ativa" &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.roleOriginal == "gerente" &&
        request.resource.data.contexto == "substituicao_operacional" &&
        request.resource.data.estado == "encerrada";
      allow delete: if false;
    }

    match /substituicao_operacional_historico/{eventoId} {
      allow read: if isGestor();
      allow create: if isGerente() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.roleOriginal == "gerente" &&
        request.resource.data.contexto == "substituicao_operacional";
      allow update, delete: if false;
    }


    // ================================================================
    // FASE 6.22.5 — ESTADO DE LEITURA DA CENTRAL DE NOTIFICAÇÕES
    // Não contém dados financeiros nem altera operações de negócio.
    // Cada utilizador lê/escreve apenas o próprio estado cross-device.
    // ================================================================
    match /notificacao_leituras/{leituraId} {
      allow read: if isAtivo() && resource.data.uid == request.auth.uid;

      allow create: if isAtivo() &&
        request.resource.data.keys().hasAll(["uid","chave","atualizadoEm"]) &&
        request.resource.data.keys().hasOnly(["uid","chave","vistaEm","lidaEm","atualizadoEm"]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.chave is string &&
        request.resource.data.chave.size() > 0;

      allow update: if isAtivo() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.chave == resource.data.chave &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["vistaEm","lidaEm","atualizadoEm"]);

      allow delete: if false;
    }

  }
}
